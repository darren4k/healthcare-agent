# ========== Production Environment Configuration ==========
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real credentials to git

# ========== Application ==========
ENV=production
DEBUG=false
APP_NAME="Healthcare Agent Platform"
APP_VERSION="1.0.0"
PORT=8001
LOG_LEVEL=INFO

# ========== Database ==========
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db:5432/healthcare_agent_prod

# ========== Redis ==========
REDIS_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_MIN_32_CHARS
REDIS_URL=redis://redis:6379/0

# ========== Security ==========
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# ========== CORS ==========
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ========== LLM Configuration ==========
# Your DGX Spark or other LLM endpoint
LLM_ENDPOINT=http://your-dgx-spark-endpoint/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-70b-instruct
LLM_TIMEOUT=120

# ========== HelloNote EMR Credentials ==========
HELLONOTE_BASE_URL=https://app.hellonote.com
HELLONOTE_USERNAME=your_hellonote_username
HELLONOTE_PASSWORD=your_hellonote_password
HELLONOTE_API_KEY=your_hellonote_api_key_if_available

# ========== Insurance Clearinghouse - Change Healthcare ==========
INSURANCE_PROVIDER=change_healthcare
INSURANCE_API_ENDPOINT=https://api.changehealthcare.com/medicalnetwork
CHANGE_HEALTHCARE_API_KEY=your_change_healthcare_api_key
CHANGE_HEALTHCARE_USERNAME=your_change_healthcare_username
CHANGE_HEALTHCARE_PASSWORD=your_change_healthcare_password

# Alternative: Availity
# INSURANCE_PROVIDER=availity
# INSURANCE_API_ENDPOINT=https://api.availity.com/availity/v1
# AVAILITY_API_KEY=your_availity_api_key

# ========== Twilio SMS (Appointment Reminders) ==========
ENABLE_SMS_REMINDERS=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# ========== SendGrid Email ==========
ENABLE_EMAIL_REMINDERS=true
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Healthcare Agent

# ========== Firebase Push Notifications (Optional) ==========
ENABLE_PUSH_REMINDERS=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# ========== Vector Database - Pinecone ==========
VECTOR_STORE=pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=healthcare-cases

# ========== OpenAI (for embeddings) ==========
EMBEDDING_MODEL=openai
OPENAI_API_KEY=your_openai_api_key

# Alternative: Use pgvector (local PostgreSQL)
# VECTOR_STORE=pgvector
# No additional configuration needed - uses existing PostgreSQL

# Alternative: Weaviate
# VECTOR_STORE=weaviate
# WEAVIATE_URL=http://weaviate:8080
# WEAVIATE_API_KEY=your_weaviate_api_key

# ========== Browser Automation ==========
BROWSER_HEADLESS=true
ENABLE_VIDEO_RECORDING=true
ENABLE_SLOW_MO=false
SLOW_MO_MS=500
ENABLE_PLAYWRIGHT_TRACING=true

# ========== Scheduling Configuration ==========
DEFAULT_APPOINTMENT_DURATION_MINUTES=45
MAX_PATIENTS_PER_THERAPIST_PER_DAY=8
AUTO_ASSIGN_THERAPISTS=true
REQUIRE_INSURANCE_VERIFICATION=true

# ========== Reminders Configuration ==========
SEND_24H_REMINDER=true
SEND_2H_REMINDER=true
REMINDER_CHECK_INTERVAL_MINUTES=5

# ========== Claims Configuration ==========
AUTO_GENERATE_CLAIMS=true
AUTO_SUBMIT_CLAIMS=false  # Set to true after testing
CLAIMS_SUBMISSION_METHOD=EDI
BATCH_SUBMIT_TIME=23:00  # 11 PM

# ========== Monitoring & Logging ==========
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
DATADOG_API_KEY=  # Optional: Add DataDog API key

# ========== Provider Information ==========
PROVIDER_NPI=1234567890
PROVIDER_TAX_ID=123456789
PROVIDER_NAME=Your Therapy Clinic
PROVIDER_PHONE=+15551234567
PROVIDER_ADDRESS=123 Main St
PROVIDER_CITY=Your City
PROVIDER_STATE=CA
PROVIDER_ZIP=12345

# ========== Facility Information ==========
PRIMARY_FACILITY_ID=1
FACILITY_NAME=Main Clinic Location
FACILITY_PHONE=+15551234567

# ========== Slack Integration (Optional) ==========
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ALERTS=#healthcare-alerts

# ========== Email Integration (Optional) ==========
ENABLE_EMAIL_INTAKE=false
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=intake@yourdomain.com
IMAP_PASSWORD=your_email_password
IMAP_FOLDER=INBOX

# ========== Backup Configuration ==========
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-s3-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2

# ========== Feature Flags ==========
ENABLE_LIVE_DASHBOARD=true
ENABLE_NATURAL_LANGUAGE_INTERFACE=true
ENABLE_MEMORY_LEARNING=true
ENABLE_HEP_MANAGEMENT=true
ENABLE_OUTCOME_TRACKING=true

# ========== Rate Limiting ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ========== Session Configuration ==========
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ========== Compliance ==========
HIPAA_MODE=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
ENCRYPTION_AT_REST=true
