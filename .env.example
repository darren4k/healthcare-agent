# Agentic SOAP Note System - Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================
# Application Settings
# ==============================================
APP_NAME=Agentic SOAP Note System
APP_VERSION=1.0.0
ENV=development
DEBUG=true
PORT=8001

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
DATABASE_URL=postgresql://agent_user:supersecure123@localhost:5432/agentic_db
SQL_ECHO=false

# ==============================================
# Redis (Task Queue & Caching)
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# LLM Configuration (DGX Spark Endpoint)
# ==============================================
LLM_ENDPOINT=http://localhost:8000/infer
LLM_MODEL=mistral-7b
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3

# ==============================================
# EMR Configuration
# ==============================================
EMR_BASE_URL=https://your-emr-system.com
EMR_USERNAME=your_emr_username
EMR_PASSWORD=your_emr_password
EMR_HEADLESS=true
EMR_TIMEOUT=60000

# ==============================================
# Email Notifications (SMTP)
# ==============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
NOTIFICATION_FROM_EMAIL=noreply@agentic-soap.ai

# ==============================================
# Security
# ==============================================
SECRET_KEY=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=your_encryption_key_here

# ==============================================
# Audit & Logging
# ==============================================
LOG_LEVEL=INFO
AUDIT_LOG_PATH=/app/data/logs/audit.log
